# macOS Finder metadata (no leading slash, so it matches at any depth)
.DS_Store

__pycache__/
*.pyc
.venv/
venv/
.env

# Lean build artifacts (regenerated by `lake build`)
lean/.lake/

# Auto-generated per-run conflict theorems (regenerated by check_conflicts.py)
lean/Legalean/Conflicts/*.lean
!lean/Legalean/Conflicts/.gitkeep
lean/Legalean/ConflictsTestScratch/
